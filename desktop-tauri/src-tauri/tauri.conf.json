{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CamDroid",
  "version": "2.0.0",
  "identifier": "com.camdroid.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CamDroid",
        "width": 1120,
        "height": 700,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0b0b0c",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Video",
    "shortDescription": "Use your Android phone as a webcam",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
